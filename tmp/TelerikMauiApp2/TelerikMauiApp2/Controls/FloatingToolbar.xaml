<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TelerikMauiApp2.Controls.FloatingToolbar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui">

    <!--
        FloatingTab 互換を狙った "下部に浮く" ツールバー。
        Items はコードビハインドで ItemsSource から生成する（RadToolbar.Items は read-only コレクション）。
    -->

    <Grid InputTransparent="False">
        <!-- 背景（余白部分）はタップスルー -->
        <Grid InputTransparent="True" />

        <!-- FloatingTab と同じ「浮いたプレート」 -->
        <telerik:RadBorder
            VerticalOptions="End"
            HorizontalOptions="Center"
            Margin="0,0,0,24"
            BackgroundColor="#FF1C1C1E"
            BorderColor="#FF3A3A3C"
            BorderThickness="1"
            CornerRadius="20"
            Padding="10"
            InputTransparent="False">

            <telerik:RadBorder.Shadow>
                <Shadow Brush="#80000000" Offset="0,6" Radius="10" Opacity="0.35" />
            </telerik:RadBorder.Shadow>

            <telerik:RadToolbar
                x:Name="Toolbar"
                BackgroundColor="Transparent"
                BorderColor="Transparent"
                BorderThickness="0"
                Orientation="Horizontal"
                OverflowMode="Scroll"
                ItemSpacing="8" />
        </telerik:RadBorder>
    </Grid>
</ContentView>
