<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             xmlns:vm="clr-namespace:TelerikMauiApp2.ViewModels"
             x:Class="TelerikMauiApp2.MainPage"
             x:DataType="vm:MainPageViewModel">

    <Grid>
        <!-- 既存コンテンツ -->
        <ScrollView>
            <VerticalStackLayout
                Spacing="25" 
                Padding="30,0" 
                VerticalOptions="Center">

                <Image
                Source="dotnet_bot.png"
                SemanticProperties.Description="Cute dot net bot waving hi to you!"
                HeightRequest="185"
                HorizontalOptions="Center" />

                <Label
                Text="Hello, World!"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1"
                FontSize="32"
                HorizontalOptions="Center" />

                <Label
                Text="Welcome to Telerik UI for .NET MAUI"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                SemanticProperties.Description="Welcome to Telerik UI for dot net Multi platform App U I"
                FontSize="18"
                HorizontalOptions="Center" />

                <Button Text="カレンダーを開く"
                    Command="{Binding OpenPopupCommand}"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    CornerRadius="8"
                    Padding="20,10"
                    Margin="0,20,0,0"
                    HorizontalOptions="Center" />

                <Button Text="Mopups内でさらにMopupsを開く"
                    Command="{Binding OpenMopupsOnlyPopupCommand}"
                    BackgroundColor="#2B88D9"
                    TextColor="White"
                    CornerRadius="8"
                    Padding="20,10"
                    Margin="0,0,0,20"
                    HorizontalOptions="Center" />

                <Button Text="BottomSheet (タブ切り替え)"
                    Command="{Binding OpenBottomSheetTabCommand}"
                    BackgroundColor="#FF6B35"
                    TextColor="White"
                    CornerRadius="8"
                    Padding="20,10"
                    Margin="0,0,0,20"
                    HorizontalOptions="Center" />

                <Button Text="Floating Toolbar (Telerik)"
                    Command="{Binding OpenFloatingToolbarCommand}"
                    BackgroundColor="#9C27B0"
                    TextColor="White"
                    CornerRadius="8"
                    Padding="20,10"
                    Margin="0,0,0,20"
                    HorizontalOptions="Center" />

                <Button Text="Side Drawer (コレクション)"
                    Command="{Binding OpenSideDrawerCommand}"
                    BackgroundColor="#E91E63"
                    TextColor="White"
                    CornerRadius="8"
                    Padding="20,10"
                    Margin="0,0,0,20"
                    HorizontalOptions="Center" />

                <Button Text="トップバナー検証ページ"
                    Command="{Binding OpenTopBannerTestCommand}"
                    BackgroundColor="#00897B"
                    TextColor="White"
                    CornerRadius="8"
                    Padding="20,10"
                    Margin="0,0,0,20"
                    HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
