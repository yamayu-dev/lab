<?xml version="1.0" encoding="utf-8" ?>
<mopups:PopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
             xmlns:vm="clr-namespace:TelerikMauiApp2.ViewModels"
             xmlns:controls="clr-namespace:TelerikMauiApp2.Controls"
             x:Class="TelerikMauiApp2.Views.MopupsCalendarPopupPage"
             BackgroundColor="#80808080">

    <mopups:PopupPage.BindingContext>
        <vm:CalendarPopupPageViewModel />
    </mopups:PopupPage.BindingContext>

    <Border Margin="20"
            Padding="20"
            BackgroundColor="White"
            StrokeThickness="0"
            VerticalOptions="Center"
            HorizontalOptions="Center">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="20">
            <Label Text="Mopups + Mopups"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="外側Mopups内からさらにMopupsを開くテストです。" />

            <controls:MopupsDatePickerEntry SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                            Placeholder="タップしてカレンダーを開きます" />
            <controls:AiFormsDatePicker />
        </VerticalStackLayout>
    </Border>
</mopups:PopupPage>
