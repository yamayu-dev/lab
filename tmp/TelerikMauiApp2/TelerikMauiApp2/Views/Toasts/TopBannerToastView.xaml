<?xml version="1.0" encoding="utf-8" ?>
<extra:ToastView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:extra="clr-namespace:AiForms.Dialogs;assembly=AiForms.Maui.Dialogs"
    x:Class="TelerikMauiApp2.Views.Toasts.TopBannerToastView"
    HorizontalLayoutAlignment="Fill"
    VerticalLayoutAlignment="Start"
    OffsetX="0"
    OffsetY="12">

    <Border
        BackgroundColor="#E6000000"
        Stroke="#40FFFFFF"
        StrokeThickness="1"
        Padding="12"
        Margin="12,0"
        StrokeShape="RoundRectangle 12">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Label Text="ℹ" FontSize="18" TextColor="White" VerticalOptions="Center" />
            <Label Grid.Column="1"
                   Text="{Binding Title}"
                   TextColor="White"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation" />
        </Grid>
    </Border>

</extra:ToastView>
