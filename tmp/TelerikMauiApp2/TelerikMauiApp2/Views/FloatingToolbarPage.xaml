<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             xmlns:vm="clr-namespace:TelerikMauiApp2.ViewModels"
             xmlns:controls="clr-namespace:TelerikMauiApp2.Controls"
             xmlns:views="clr-namespace:TelerikMauiApp2.Views.SearchViews"
             xmlns:selectors="clr-namespace:TelerikMauiApp2.Selectors"
             x:Class="TelerikMauiApp2.Views.FloatingToolbarPage"
             x:DataType="vm:FloatingToolbarPageViewModel"
             Title="Floating Toolbar">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ButtonToolbarStyle" TargetType="telerik:ButtonToolbarItemView">
                <Setter Property="DisplayOptions" Value="Text"/>
                <Setter Property="TextColor" Value="Black"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="BackgroundColor" Value="LightGray"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderColor" Value="Black"/>
            </Style>
            <Style x:Key="RadioButtonToolbarStyle" TargetType="telerik:RadioButtonToolbarItemView">
                <Setter Property="DisplayOptions" Value="Text"/>
                <Setter Property="TextColor" Value="Black"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="BackgroundColor" Value="LightGray"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderColor" Value="Black"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="AliceBlue">

        <controls:SmartBottomSheet
            x:Name="SmartSheet"
            ZIndex="1"
            PeekHeight="80"
            PartialHeight="50%"
            FullHeight="90%"
            InitialState="Peek"
            MinimumState="Peek"
            CollapseThreshold="0.5"
            ShowDebug="True">

            <controls:SmartBottomSheet.MainContent>
                <VerticalStackLayout
                    Padding="16"
                    VerticalOptions="Start"
                    BackgroundColor="LightBlue">

                    <Label Text="{Binding DebugText, Source={x:Reference SmartSheet}}" />
                    <HorizontalStackLayout
                        Spacing="12"
                        HorizontalOptions="Center"
                        VerticalOptions="Start">

                        <Button
                            Text="表示"
                            Command="{Binding OpenCommand, Source={x:Reference SmartSheet}}"
                            BackgroundColor="#512BD4"
                            TextColor="White"
                            CornerRadius="8"
                            Padding="14,10" />

                        <Button
                            Text="最小化"
                            Command="{Binding CloseCommand, Source={x:Reference SmartSheet}}"
                            BackgroundColor="#424242"
                            TextColor="White"
                            CornerRadius="8"
                            Padding="14,10" />

                    </HorizontalStackLayout>
                    <Label Text="MainContent" Margin="0,60,0,0" />
                    <Editor Placeholder="Editor" />
                </VerticalStackLayout>
            </controls:SmartBottomSheet.MainContent>

            <controls:SmartBottomSheet.SheetContent>
                <Grid Padding="16,12" BackgroundColor="LightCyan">
                    <Grid RowDefinitions="Auto,*">
                        <VerticalStackLayout Grid.Row="0" Spacing="8" Margin="0,0,0,12">
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                <telerik:RadEntry Grid.Row="0" Grid.Column="0" Placeholder="商品未選択"
                                                  Text="{Binding SelectedProductInfo}"
                                                  IsReadOnly="True" />
                                <Button Grid.Row="0" Grid.Column="1" Text="🔍 検索"
                                        Command="{Binding OpenProductSearchCommand}"
                                        BackgroundColor="#512BD4"
                                        TextColor="White"
                                        CornerRadius="8"
                                        Padding="12,8" />
                                <telerik:RadEntry Grid.Row="1" Grid.Column="0" Placeholder="得意先未選択"
                                                  Text="{Binding SelectedCustomerInfo}"
                                                  IsReadOnly="True" />
                                <Button Grid.Row="1" Grid.Column="1" Text="🔍 検索"
                                        Command="{Binding OpenCustomerSearchCommand}"
                                        BackgroundColor="#512BD4"
                                        TextColor="White"
                                        CornerRadius="8"
                                        Padding="12,8" />
                            </Grid>
                        </VerticalStackLayout>

                        <Grid Grid.Row="1">
                        <ContentView IsVisible="{Binding IsDockHomeVisible}">
                            <ScrollView>
                                <VerticalStackLayout Spacing="12">
                                    <Label Text="Dock: ホーム" TextColor="Black" FontAttributes="Bold" FontSize="20" />
                                    <telerik:RadEntry Placeholder="メモ" Text="{Binding HomeText}" />
                                </VerticalStackLayout>
                            </ScrollView>
                        </ContentView>

                        <ContentView IsVisible="{Binding IsDockSettingsVisible}">
                            <ScrollView>
                                <VerticalStackLayout Spacing="12">
                                    <Label Text="Dock: 設定" TextColor="Black" FontAttributes="Bold" FontSize="20" />
                                    <HorizontalStackLayout Spacing="12">
                                        <Label Text="通知" VerticalOptions="Center" />
                                        <telerik:RadCheckBox IsChecked="{Binding NotificationEnabled}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Text="ボリューム" />
                                    <telerik:RadSlider Minimum="0" Maximum="100" Value="{Binding VolumeValue}" />
                                </VerticalStackLayout>
                            </ScrollView>
                        </ContentView>

                        <ContentView IsVisible="{Binding IsDockInfoVisible}">
                            <ScrollView>
                                <VerticalStackLayout Spacing="12">
                                    <Label Text="Dock: 情報" TextColor="Black" FontAttributes="Bold" FontSize="20" />
                                    <telerik:RadBorder BorderColor="#2E2E2E"
                                                      BorderThickness="1"
                                                      BackgroundColor="#1C1C1E"
                                                      CornerRadius="14"
                                                      Padding="14">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="TelerikMauiApp2" TextColor="White" FontAttributes="Bold" />
                                            <Label Text="Version: 1.0.0" TextColor="#BDBDBD" />
                                            <Label Text="Build: 2026-01-11" TextColor="#BDBDBD" />
                                        </VerticalStackLayout>
                                    </telerik:RadBorder>
                                </VerticalStackLayout>
                            </ScrollView>
                        </ContentView>
                    </Grid>
                    </Grid>
                </Grid>
            </controls:SmartBottomSheet.SheetContent>

        </controls:SmartBottomSheet>

        <controls:ModalBottomSheet
            x:Name="ModalSheet"
            ZIndex="3"
            FullHeight="90%"
            InitialState="Hidden"
            MinimumState="Hidden"
            State="{Binding ModalState, Mode=TwoWay}">
            
            <controls:ModalBottomSheet.SheetContent>
                <controls:ModalBottomSheetTemplateHost
                    x:Name="ModalHost"
                    ViewModel="{Binding ModalContentViewModel}">

                    <controls:ModalBottomSheetTemplateHost.TemplateSelector>
                        <x:Reference Name="ModalContentTemplateSelector" />
                    </controls:ModalBottomSheetTemplateHost.TemplateSelector>

                    <controls:ModalBottomSheetTemplateHost.Resources>
                        <DataTemplate x:Key="ProductSearchViewTemplate">
                            <views:ProductSearchView />
                        </DataTemplate>
                        <DataTemplate x:Key="CustomerSearchViewTemplate">
                            <views:CustomerSearchView />
                        </DataTemplate>

                        <selectors:ModalContentViewModelTemplateSelector
                            x:Name="ModalContentTemplateSelector"
                            x:Key="ModalContentTemplateSelector"
                            DefaultTemplate="{x:Null}">
                            <selectors:ModalContentViewModelTemplateSelector.Mappings>
                                <selectors:ViewModelTemplateMapping
                                    ViewModelType="{x:Type vm:ProductSearchViewModel}"
                                    Template="{StaticResource ProductSearchViewTemplate}" />
                                <selectors:ViewModelTemplateMapping
                                    ViewModelType="{x:Type vm:CustomerSearchViewModel}"
                                    Template="{StaticResource CustomerSearchViewTemplate}" />
                            </selectors:ModalContentViewModelTemplateSelector.Mappings>
                        </selectors:ModalContentViewModelTemplateSelector>
                    </controls:ModalBottomSheetTemplateHost.Resources>
                </controls:ModalBottomSheetTemplateHost>
            </controls:ModalBottomSheet.SheetContent>
        </controls:ModalBottomSheet>

        <!-- Telerik RadToolbar replacing FloatingTab -->
        <telerik:RadToolbar
            ZIndex="2"
            IsVisible="{Binding IsMinimumState, Source={x:Reference SmartSheet}, Converter={StaticResource InverseBooleanConverter}}"
            VerticalOptions="End"
            HorizontalOptions="Center"
            Margin="0,0,0,24"
            BackgroundColor="WhiteSmoke"
            CornerRadius="10"
            Padding="8,4">

            <!--
            <telerik:ButtonToolbarItem Text="Home"
                Style="{StaticResource ButtonToolbarStyle}"
                Command="{Binding SelectDockTabCommand}"
                CommandParameter="0">
            </telerik:ButtonToolbarItem>
            <telerik:ButtonToolbarItem Text="Settings"
                Command="{Binding SelectDockTabCommand}"
                CommandParameter="1" />
            <telerik:SeparatorToolbarItem />
            <telerik:ButtonToolbarItem Text="Info"
                Command="{Binding SelectDockTabCommand}"
                CommandParameter="2" />
            -->
            <telerik:RadioButtonToolbarItem Text="Home"
                Style="{StaticResource RadioButtonToolbarStyle}"
                Command="{Binding SelectDockTabCommand}"
                CommandParameter="0">
            </telerik:RadioButtonToolbarItem>
            <telerik:RadioButtonToolbarItem Text="Settings"
                Style="{StaticResource RadioButtonToolbarStyle}"
                Command="{Binding SelectDockTabCommand}"
                CommandParameter="1" />
            <telerik:SeparatorToolbarItem />
            <telerik:RadioButtonToolbarItem Text="Info"
                Style="{StaticResource RadioButtonToolbarStyle}"
                Command="{Binding SelectDockTabCommand}"
                CommandParameter="2" />

        </telerik:RadToolbar>

    </Grid>
</ContentPage>
