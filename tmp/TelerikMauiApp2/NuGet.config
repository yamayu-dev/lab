<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Goal: Restore Telerik packages from Telerik feed, and everything else from nuget.org.
    This repo-local NuGet.config takes precedence over global settings when working in this folder.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="telerik.com" value="https://nuget.telerik.com/v3/index.json" />
  </packageSources>

  <!-- Keep the restore deterministic: only Telerik.* goes to Telerik feed; everything else goes to nuget.org. -->
  <packageSourceMapping>
    <packageSource key="telerik.com">
      <package pattern="Telerik.*" />
      <package pattern="Kendo.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
