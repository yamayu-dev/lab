<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WhisperSample.MainPage">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <HorizontalStackLayout Spacing="12">
            <Button x:Name="StartBtn" Text="Start" Clicked="OnStartClicked" />
            <Button x:Name="StopBtn" Text="Stop" Clicked="OnStopClicked" IsEnabled="False" />
        </HorizontalStackLayout>

        <ScrollView Grid.Row="1">
            <Label x:Name="TranscriptLabel" Text="Transcription will appear here" LineBreakMode="WordWrap" />
        </ScrollView>

    </Grid>

</ContentPage>
