<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WhisperSample.MainPage">

    <VerticalStackLayout Padding="16" Spacing="12">

        <HorizontalStackLayout Spacing="12">
            <Button x:Name="StartBtn" Text="Start" Clicked="OnStartClicked" />
            <Button x:Name="StopBtn" Text="Stop" Clicked="OnStopClicked" IsEnabled="False" />
        </HorizontalStackLayout>

        <Label Text="Transcription" FontAttributes="Bold" />

        <ScrollView VerticalOptions="Fill">
            <Label x:Name="TranscriptLabel" Text="" LineBreakMode="WordWrap" />
        </ScrollView>

    </VerticalStackLayout>

</ContentPage>
